# Jellyfin Mediaserver Tools Configuration Template
# Copy this to ~/.config/mediaserver/config.env and populate with your own keys!

# 1. Jellyfin Settings
# The URL of your Jellyfin server
JELLYFIN_URL="http://localhost:8096"
# Your Jellyfin API Key (generated in Jellyfin Dashboard > API Keys)
JELLYFIN_KEY="your_jellyfin_api_key_here"

# 2. ntfy Notification Settings
# The URL of your ntfy.sh topic (e.g. https://ntfy.sh/your_custom_topic)
NTFY_URL="https://ntfy.sh/your_custom_topic_here"

# 3. qBittorrent Settings
# The Web UI URL of your qBittorrent client
QBT_URL="http://localhost:8080"

# 4. Log Settings (Optional — sensible per-user defaults are used if unset)
# Verbose per-video fetchsub log:
# LOG_FILE="$HOME/.config/opensubtitles/fetchsub.log"
# Concise shared lifecycle log written by grab/postdl/fetchsub:
# PROJECT_LOG="$HOME/.config/mediaserver/mediaserver.log"
